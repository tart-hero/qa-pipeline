# Copy file này thành ".env" (bỏ phần .example) rồi điền giá trị thật.
# KHÔNG commit file ".env" thật lên Git.

# --- Metabase ---
METABASE_URL=https://metabase.laiostech.com
METABASE_API_KEY=mb_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Adjust ---
ADJUST_API_TOKEN=your_adjust_workspace_token
ADJUST_APP_TOKEN_CDS_ANDROID=your_app_token_tren_adjust
# Khi thêm game B (iOS), thêm dòng tương ứng, ví dụ:
# ADJUST_APP_TOKEN_CDS_IOS=your_app_token_ios
